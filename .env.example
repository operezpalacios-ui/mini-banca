# Copia este fichero como .env y rellena los valores. El .env NUNCA se sube al repo.

# --- Core: base de datos ---
# DB_URL es opcional: si no se pone, se usa el Postgres local de Docker.
DB_URL=
DB_USER=
DB_PASSWORD=

# --- Orquestador: clave para firmar los JWT (Base64, mínimo 32 bytes) ---
JWT_SECRET=

# --- Core y orquestador: clave compartida servicio a servicio (mínimo 32 caracteres) ---
INTERNAL_API_KEY=

# --- Core: Redis para la caché (lección 11). Upstash: rediss://default:CONTRASEÑA@HOST:6379 ---
# Ojo: "rediss" con DOS eses = conexión cifrada (TLS). Si no se pone, la app funciona SIN caché.
REDIS_URL=

# --- Solo para docker compose (lección 14): contraseña del Postgres LOCAL dentro de Docker ---
LOCAL_DB_PASSWORD=
